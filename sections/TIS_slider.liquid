<featured-collection-carousel
        data-arrows="{{ section.settings.show_arrow }}"
        data-auto_play="{{  section.settings.auto_play }}"
        data-group_cell="{{  section.settings.group_cell }}"

            data-bars="true"
        class="popular-treatments__slider"
      >
                {% comment %} <img
                  srcset="
                    {%- if block.settings.Offer_img.width >= 165 -%}{{ block.settings.Offer_img | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if block.settings.Offer_img.width >= 360 -%}{{ block.settings.Offer_img | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if block.settings.Offer_img.width >= 533 -%}{{ block.settings.Offer_img | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if block.settings.Offer_img.width >= 720 -%}{{ block.settings.Offer_img | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if block.settings.Offer_img.width >= 940 -%}{{ block.settings.Offer_img | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if block.settings.Offer_img.width >= 1066 -%}{{ block.settings.Offer_img | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ block.settings.Offer_img | image_url }} {{ block.settings.Offer_img.width }}w
                  "
                  src="{{ block.settings.Offer_img | image_url: width: 533 }}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  alt="{{ block.settings.Offer_img.alt | escape }}"
                  class="motion-reduce"
                  width="{{ block.settings.Offer_img.width }}"
                  height="{{ block.settings.Offer_img.height }}"
                > {% endcomment %}
</featured-collection-carousel>



{% schema %}
    {
      "name": "slider",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_arrow",
          "default": true,
          "label": "Show Arrow"
        },
        {
          "type": "range",
          "id": "group_cell",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Group Cell",
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "auto_play",
          "default": true,
          "label": "Auto_play"
        }
      ],
      "presets": [
        {
          "name": "slider"
        }
      ]
    }
    {% endschema %}