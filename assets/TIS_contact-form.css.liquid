.cnt_frm .form-vertical form label{    font-size: 14px;text-align: left;font-family: Star Jedi;line-height: 1.6;font-weight: 400;letter-spacing: 2px;text-transform: lowercase;}
.cnt_frm .form-vertical form .btn{background:  var(--white)0% 0% no-repeat padding-box;border-radius: 12px;padding: 6px 35px;font-size: 17px;font-weight: 700;line-height: 1.4;letter-spacing: 2.04px;font-family: Star Jedi;color: var(--orange);display: inline-block;transition: .5s color ease;position: relative;z-index: 0;text-transform: lowercase;    border: 1px solid transparent;}
.cnt_frm .form-vertical form .btn::before{transition: .5s all ease;position: absolute;top: 0;left: 50%;right: 50%;bottom: 0;opacity: 0;content: "";background-color: var(--primary-color);z-index: -2;border-radius: 12px;}
.cnt_frm .form-vertical form .btn::after{content: none;}
.cnt_frm .form-vertical form .btn:hover{    color: var(--black);transition: .5s color ease;    border: 1px solid transparent;}
.cnt_frm .form-vertical form .btn:hover::before{transition: .5s all ease;left: 0;right: 0;opacity: 1;}
.cnt_frm .form-vertical form  p a{color:var(--primary-color) ;transition: all .5s ease;}
.cnt_frm .form-vertical form  p a:hover{color: #fff;}