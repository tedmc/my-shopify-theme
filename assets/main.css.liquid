.product-section.is-modal .page-content .product-block .collapsibles-wrapper form .btn::before{    transition: .5s all ease;position: absolute;top: 0;left: 50%;right: 50%;bottom: 0;opacity: 0;content: "";background-color: var(--orange);z-index: -2;border-radius: 17px;}
