@import "TIS_collection.css";
.grid-search__page-link {
    padding: 0px;
    border-radius: 30px;
}
.grid__item.grid-search{
    padding-left: 60px;
}
.grid-search__page{
    border-radius: 30px;
    border: 1px solid var(--primary-color);
    height: 100%;
}
.grid-search__page img{
    border-radius: 30px 30px 0 0 ;
}
.grid-search__page-info{
    padding: 14px;
}
.collection-content .collection-grid__wrapper .grid--uniform{
    display: flex;
    flex-wrap: wrap;
    row-gap: 40px;
}
.grid-search, .collection-content .collection-grid__wrapper .grid--uniform .grid-product {
    margin-bottom: 0;
}
.grid-search__page-info .h4{
    text-transform: lowercase;
    letter-spacing: 2px;
}
@media (max-width: 1440px) {
    .grid__item.grid-search{
        padding-left: 40px;
    }
}
@media (max-width: 1200px) {
    .grid__item.grid-search{
        padding-left: 20px;
        width: 33.33%;
    }
}
@media (max-width: 991px) {
    .grid__item.grid-search{        
        width: 50%;
    }
}
 