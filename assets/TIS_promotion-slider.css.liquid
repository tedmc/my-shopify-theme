.promotion_card{
    position: relative;
    border-radius: 25px;  
    margin-right: 15px;
    margin-left: 14px;
    width: calc(22% - 30px);
  }
  .promotion_card img{
    border-radius: 25px;
    max-width: 100%;
    height: 100%;
  }
  .offer-badge{
    position: absolute;
    top: 29px;
    left: 29px;
    background: var(--white)0% 0% no-repeat padding-box;
    width: 85px;
    height: 85px;
    border-radius: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }
  .offer-badge span{  
    text-align: center;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0px;
    color: var(--orange);
  }
  .promo_info{
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
  }
  .promo-cnt{
    max-width: 319px;
    margin-inline: auto;
  }
  .promo-cnt p{
     font-size: 17px;
    font-weight: bold;
    line-height: 1.4;
    letter-spacing: 2.04px;  
    margin-bottom: 0px;
  }
  .promo_btn{
    margin-top: 22px;
    text-align: center;
  }
  .promo_btn a{
    background:var(--white) 0% 0% no-repeat padding-box;
    border-radius: 12px;
    padding: 6px 35px;
    font-size: 17px;
    font-weight: bold;
    line-height: 1.4;
    letter-spacing: 2.04px;
    font-family: "Star Jedi";
    color: var(--orange);
    display: inline-block;
    transition: 0.5s color ease;
    position: relative;
    z-index: 0;
  }
  .promotion_slide{
    padding-block: 91px 65px;
  }
  .promo_btn a:hover{
    color: var(--black);
    transition: 0.5s color ease;
  }
  .promo_btn a:before {
    -webkit-transition: 0.5s all ease;
    transition: 0.5s all ease;
    position: absolute;
    top: 0;
    left: 50%;
    right: 50%;
    bottom: 0;
    opacity: 0;
    content: "";
    background-color: var(--primary-color);
    z-index: -2;
    border-radius: 12px;
  }
  .promo_btn a:hover:before {
    -webkit-transition: 0.5s all ease;
    transition: 0.5s all ease;
    left: 0;
    right: 0;
    opacity: 1;
  }
  .promotion_card:before{
    content:"";
    position: absolute;
    top: 0;
    left: 0;
    background-color: rgb( 0 0 0 / 19%);
    width: 100%;
    height: 100%;
  }
  promotion-carousel .flickity-button{
    background-color: var(--white);
    color: var(--orange);
  }
  promotion-carousel .flickity-button{display: none;}

@media (max-width: 1600px) {
    .promotion_card{        
        width: calc(25% - 30px);
    } 
    .offer-badge{        
        width: 70px;
        height: 70px;
    }
}
@media (max-width: 1200px) {
    .promotion_card{        
        width: calc(33.33% - 30px);
    } 
    .offer-badge{        
        width: 65px;
        height: 65px;
    }
    .promo_info{
        padding-inline: 10px;
    }
    .promo-cnt p, .promo_btn a{
        letter-spacing: 0px;
    }
}
@media (max-width: 991px) {
    .promotion_card{        
        width: calc(33.33% - 20px);
        margin-left: 10px;
        margin-right: 10px;
    } 
    .offer-badge{        
        width: 60px;
        height: 60px;
    }
    
    .promo-cnt p, .promo_btn a, .offer-badge span{
        font-size: 14px;
    }
    .promo_btn a {        
        padding: 6px 20px;
    }
    .promo_btn{
        margin-top: 15px;
    }
}
@media (max-width: 768px) {
    .promotion_card{        
        width: calc(50% - 20px);
        margin-left: 10px;
        margin-right: 10px;
    } 
    .offer-badge{        
        width: 55px;
        height: 55px;
    }        
    .promo_btn a {        
        padding: 6px 14px;
    }    
    .promotion_slide{
        padding-block: 30px;
    }
}
@media (max-width: 600px) {
    .promotion_card{        
        width: calc(80% - 20px);        
    } 
}