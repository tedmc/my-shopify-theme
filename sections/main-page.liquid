{{ "TIS_page.css" | asset_url | stylesheet_tag }}
<div class="page-width page-width--narrow page-content{% if request.path contains "track-your-order" %} track_cnt_cent{% endif %}">
  {%- render 'breadcrumbs' -%}
  <header class="section-header page_header">
    <h1 class="section-header__title">{{ page.title }}</h1>
  </header>

  <div class="rte rte--nomargin">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "page-info"
}
{% endschema %}
