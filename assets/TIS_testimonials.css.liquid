.testimonails{
    padding-block: 116px 140px;
}
.side-box{
    background-color: var(--colorTextBody);
    max-width: 861px;
    padding: 75px;
    width: 50%;
  }
  .testi-wrapper{
    display: flex;
    gap: 72px;
    position: relative;
  }
  .testimonails .page-width{
    max-width: 1824px;
  }
  .box-title h2{
    color: var(--black);
  }
  .box-content{
    display: flex;
   gap: 25px;
 }
.testi_badge{
  width: 154px;
}
.testi_info{
  flex: 1;
}
.box-subhead{
  font-size: 25px;
  color: var(--black);
  text-align:center;
  font-weight: 500;
}
.box-desc p{
  color: var(--black);
  font-size: 18px;
  margin-bottom: 0px;
  text-align: center;
  margin-top: 24px;
}
.box-star-btn{
  display: flex;
  justify-content: space-between;
  margin-top: 95px;
}
.ctn-btn a{
  font-size: 18px;  
  color: var(--black);
  background-color: var(--primary-color);
  border-radius: 17px;
  padding:3px 17px;
  display: inline-block;
  position: relative;
  z-index: 0;
  transition: 0.5s color ease;
}
.ctn-btn a:hover{  
  color: var(--white);
  transition: 0.5s color ease;
}
.ctn-btn a:before {
  -webkit-transition: 0.5s all ease;
  transition: 0.5s all ease;
  position: absolute;
  top: 0;
  left: 50%;
  right: 50%;
  bottom: 0;
  opacity: 0;
  content: "";
  background-color: var(--orange);
  z-index: -2;
  border-radius: 17px;
}
.ctn-btn a:hover:before {
  -webkit-transition: 0.5s all ease;
  transition: 0.5s all ease;
  left: 0;
  right: 0;
  opacity: 1;
}
.box-star svg{
  width: auto;
  height: 31px;
}
.testimonail_slider{
  flex: 1;
}
.quote-icon{
  position: absolute;
  right: 0;
  top: -40px;  
}
.testi-desc p{
  margin-bottom: 0px;
}
.testimonial_item{
  padding-top: 20px;  
  /* display: flex;
  flex-wrap: wrap;
  align-items: flex-start; */
  /* gap: 20px; */
}
.testi-desc p{
  font-size: 18px;
  line-height: 2.223;
}
.clint-name{
  font-weight: 500;
  font-size: 25px;
  margin-top: auto;
}
.testimonail_slider .flickity-page-dots{
  width: auto;
  right: 0;
  bottom: 0px;
}
.testimonail_slider[data-bars=true] .flickity-page-dots .dot{
  width: 69px;
  height: 16px;
}


.testimonail_slider[data-bars=true] .flickity-page-dots .dot:after{
  animation-duration: 3000ms;
}
.box-content{
  margin-top: 88px;
}

@media (max-width: 1600px) {
  .side-box{
    padding: 60px;
  }
  .box-star-btn, .box-content {    
    margin-top: 60px;
  }
  .testi_badge {
    width: 130px;
  }
}
@media (max-width: 1400px) {
  .side-box{
    padding: 45px;
  }
  .box-star-btn, .box-content {    
    margin-top: 45px;
  }
  .testi_badge {
    width: 125px;
  }
  .user-img{
    width: 150px;
  }
  .testimonails{
    padding-block: 100px;
  }
}
@media (max-width: 1200px) {
  .side-box{
    padding: 25px;
  }
  .box-star-btn, .box-content {    
    margin-top: 25px;
  }
  .testi_badge {
    width: 100px;
  }
  .testi-wrapper {
    gap: 35px;
  }
  .testi-desc p {   
    line-height: 1.5;
  }
  .testi-desc p, .box-desc p{
    font-size: 16px;
  }
  .box-subhead, .clint-name{
    font-size: 22px;
  }
  .user-img{
    width: 120px;
  }
  .box-star svg{
    height: 20px;
  }
}
@media (min-width: 992px) {
  .testimonail_slider .flickity-viewport{
    height: 100% !important;
  }
  .testimonail_slider .flickity-slider{
    height: 100%;
  }
  .testimonial_item{   
    height: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 20px;
  }
}
@media (max-width: 991px) {
  .testi-wrapper{
    flex-wrap: wrap;
  }
  .side-box{
    max-width: 100%;
    width: 100%;
  }
  .quote-icon{
    top: 50%;
    width: 100px;
  }
  .testi-desc, .clint-name{
    margin-top: 20px;
  }
  .testimonails {
    padding-block: 50px;
  }
}
@media (max-width: 768px) {
  .testimonail_slider[data-bars=true] .flickity-page-dots .dot{
    height: 10px;
  }
  .testimonial_item{
    padding-top: 0px;
  }
  .testi-desc p, .box-desc p{
    font-size: 14px;
  }
  .box-subhead, .clint-name{
    font-size: 20px;
  }
  .side-box {
    padding: 15px;
  }
  .box-star-btn, .box-content {
    margin-top: 15px;
  }
  .box-content{
    justify-content: center;
  }
  .box-content{
    flex-wrap: wrap;
  }
  .testi_info{
    flex: 0 0 100%;
  }
  .ctn-btn a {
    font-size: 16px;
  }
  .quote-icon {
    top: 55%;
  }
  .testimonails {
    padding-block: 30px;
  }
  .testimonail_slider .flickity-page-dots{
    bottom: -25px;
    width: 100%;
  }
  .testi-desc, .clint-name{
    margin-top: 15px;
  }
}