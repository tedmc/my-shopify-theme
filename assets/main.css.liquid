/* Quick Shop Modal */
/* product page css start ticore11 9-1-2025 */

.product-section.is-modal .page-content .product-block .product-single__title{    text-align: left;}
.product-section.is-modal .page-content .product-block .areviews_main_header_container span{color: var(--colorTextBody) !important;}
